# -----------------------------------------------------------------------------
# Certificates and CA state — everything under certs/ is generated by
# scripts/gen-certs.sh at runtime. Do not commit runtime state.
# -----------------------------------------------------------------------------
certs/*.crt
certs/*.key
certs/*.csr
certs/*.srl
certs/ca.arn

# -----------------------------------------------------------------------------
# Run outputs — logs, pcaps, CloudWatch dumps, etc. Regenerated per run.
# -----------------------------------------------------------------------------
artifacts/
*.pcap

# -----------------------------------------------------------------------------
# Compiled Go binaries (produced by go build)
# -----------------------------------------------------------------------------
server/quic-server
server/quic-nlb-demo
client/quic-client
client/client
*.test
*.out

# -----------------------------------------------------------------------------
# OS / editor / tool metadata
# -----------------------------------------------------------------------------
.DS_Store
~$*
*.bak

# -----------------------------------------------------------------------------
# Local secrets / session state — never commit
# -----------------------------------------------------------------------------
.aws-nlb-session
.env
.envrc

# Diagram sources — kept locally for editing, not shipped in the repo.
# Customers see the rendered PNG (images/*.png) instead.
images/*.drawio

# Holmes MCP working state — local scan cache, not part of the shipping repo.
.holmes/

# Blog drafts — kept locally for the author, not shipped in the sample-code repo.
QUIC-Blog-Reviewed.docx
